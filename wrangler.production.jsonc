{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cs35-production",
  "account_id": "e8912e2867beecc673d171907bf09649",
  "main": "worker.ts",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "minify": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "cs35-production"
    }
  ],
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "cs35-production-cache"
    }
  ],
  "d1_databases": [
    {
      "binding": "CS35_DB",
      "database_name": "cs35-production",
      "database_id": "991e3c70-d792-4597-b40a-b9c7a677f17b",
      "migrations_dir": "drizzle-d1"
    },
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "cs35-production",
      "database_id": "991e3c70-d792-4597-b40a-b9c7a677f17b"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  },
  "workflows": [
    {
      "name": "cs35-scan-production",
      "binding": "SCAN_PIPELINE",
      "class_name": "ScanPipeline"
    }
  ],
  "vars": {
    "CS35_DEPLOYMENT_MODE": "production"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "NEXT_CACHE_DO_QUEUE",
        "class_name": "DOQueueHandler"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-cache-queue",
      "new_sqlite_classes": [
        "DOQueueHandler"
      ]
    }
  ],
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "triggers": {
    "crons": [
      "0 0 * * *",
      "*/5 * * * *"
    ]
  }
}
