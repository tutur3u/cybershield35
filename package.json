{
	"name": "cybershield35",
	"version": "0.1.0",
	"description": "A modern open source intelligence (OSINT) platform for cybersecurity.",
	"private": true,
	"author": "Tuturuuu",
	"homepage": "https://github.com/tutur3u/starter#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tutur3u/starter.git"
	},
	"bugs": {
		"url": "https://github.com/tutur3u/starter/issues"
	},
	"scripts": {
		"build": "node node_modules/next/dist/bin/next build",
		"brand:generate": "bun --conditions react-server scripts/generate-brand-assets.tsx",
		"db:analyze-intelligence": "bun --conditions react-server scripts/run-d1-task.ts analyze-intelligence-db",
		"db:backfill-intelligence": "bun --conditions react-server scripts/run-d1-task.ts backfill-intelligence",
		"db:backfill-topics": "bun --conditions react-server scripts/run-d1-task.ts backfill-topics",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "wrangler d1 migrations apply CS35_DB --local",
		"db:reclassify-risk": "bun --conditions react-server scripts/run-d1-task.ts reclassify-evidence-risk",
		"db:regenerate-headlines": "bun --conditions react-server scripts/run-d1-task.ts regenerate-article-headlines",
		"dev": "next dev",
		"lint": "node node_modules/eslint/bin/eslint.js",
		"perf:analyze": "TURBOPACK=1 node node_modules/next/dist/bin/next experimental-analyze --output",
		"start": "node node_modules/next/dist/bin/next start",
		"test": "bun scripts/test-isolated.ts",
		"test:e2e:instant": "playwright test",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"typecheck:test": "tsc --noEmit -p tsconfig.test.json",
		"zalo:cleanup-hidden": "bun --conditions react-server scripts/run-d1-task.ts cleanup-hidden-zalo-drafts",
		"build:cloudflare": "opennextjs-cloudflare build",
		"preview:cloudflare": "opennextjs-cloudflare preview",
		"cf:typegen": "wrangler types --include-runtime false --env-interface CloudflareEnv cloudflare-env.d.ts",
		"db:migrate:staging": "wrangler d1 migrations apply CS35_DB --remote",
		"db:migrate:production": "wrangler d1 migrations apply CS35_DB --remote --config wrangler.production.jsonc",
		"deploy:cloudflare": "opennextjs-cloudflare deploy --config wrangler.production.jsonc"
	},
	"dependencies": {
		"@ai-sdk/google": "^4.0.34",
		"@ai-sdk/openai": "^4.0.30",
		"@ai-sdk/react": "^4.0.55",
		"@opennextjs/cloudflare": "^1.20.6",
		"@opentelemetry/api": "^1.9.1",
		"@streamdown/cjk": "^1.0.3",
		"@streamdown/code": "^1.1.1",
		"@streamdown/math": "^1.0.2",
		"@streamdown/mermaid": "^1.0.2",
		"@tanstack/react-query": "^5.101.4",
		"@tanstack/react-virtual": "^3.14.9",
		"@tuturuuu/ui": "^0.24.0",
		"ai": "^7.0.52",
		"apify-client": "^2.24.0",
		"browser-use-sdk": "^3.10.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"docx": "^9.7.1",
		"drizzle-orm": "^0.45.2",
		"firecrawl": "^4.32.0",
		"lucide-react": "^1.28.0",
		"nanoid": "^6.0.1",
		"next": "16.3.3",
		"pdfmake": "^0.3.11",
		"postgres": "^3.4.9",
		"radix-ui": "^1.6.7",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"server-only": "^0.0.1",
		"shadcn": "^4.16.1",
		"shiki": "4.3.1",
		"streamdown": "^2.5.0",
		"tailwind-merge": "^3.6.0",
		"tw-animate-css": "^1.4.0",
		"use-stick-to-bottom": "^1.1.6",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20260915.1",
		"@next/playwright": "16.3.0",
		"@playwright/test": "^1.62.1",
		"@tailwindcss/postcss": "^4.3.3",
		"@tuturuuu/typescript-config": "^0.1.1",
		"@types/bun": "^1.3.14",
		"@types/node": "^26.1.2",
		"@types/pdfmake": "^0.3.3",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@typescript-eslint/typescript-estree": "^8.66.0",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.8.0",
		"eslint-config-next": "16.3.0",
		"tailwindcss": "^4.3.3",
		"typescript": "6.0.3",
		"wrangler": "^4.131.2"
	},
	"overrides": {
		"next": "16.3.3"
	},
	"trustedDependencies": [
		"@mongodb-js/zstd",
		"@parcel/watcher",
		"@swc/core",
		"baileys",
		"node-liblzma",
		"protobufjs",
		"unrs-resolver"
	]
}
