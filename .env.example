DATABASE_URL=postgres://cybershield:cybershield@localhost:5432/cybershield35
AUTH_LOCAL_BYPASS=false

# Tuturuuu external app login. Keep all values server-side only.
TUTURUUU_API_BASE_URL=https://tuturuuu.com/api/v1
TUTURUUU_WEB_APP_URL=https://tuturuuu.com
TUTURUUU_EXTERNAL_APP_APPROVAL_URL=https://tuturuuu.com/vi/internal/infrastructure/external-apps/approve
TUTURUUU_CYBERSHIELD35_WORKSPACE_ID=
CYBERSHIELD35_APP_ID=cybershield35
CYBERSHIELD35_APP_SECRET=
# Optional public origin used when managed scheduler callbacks are configured.
CYBERSHIELD35_PUBLIC_APP_URL=
# Optional: defaults to CYBERSHIELD35_APP_SECRET when unset, like Yashie.
CYBERSHIELD35_SESSION_SECRET=
# Requested external-app scopes are code-owned:
# workspace:session, ai:use, tts:use, workspace:members:read, workspace:members:write,
# workspace:roles:read, workspace:roles:write, workspace:cron:read,
# workspace:cron:write, users:profile:read, users:profile:write

# Provider and LLM keys. Do not expose these as NEXT_PUBLIC_*.
OPENAI_API_KEY=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_GENERATIVE_AI_MODEL=gemini-3.1-flash-lite
TUTURUUU_AI_BASE_URL=https://ai.tuturuuu.com/v1
TUTURUUU_AI_MODEL=google/gemini-3.1-flash-lite
AI_MODEL_ALLOWLIST=google/gemini-3.1-flash-lite,google/gemini-3.6-flash
TUTURUUU_TTS_MODEL=google/gemini-3.1-flash-tts-preview
TUTURUUU_TTS_VOICE=Kore
APIFY_TOKEN=
FIRECRAWL_API_KEY=
BROWSER_USE_API_KEY=

# Zalo Official Account article publishing. Keep disabled until OAuth permissions
# and the callback URL are approved in the Zalo developer console.
ZALO_OA_ENABLED=false
ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_TOKEN_ENCRYPTION_KEY=
ZALO_REDIRECT_URI=

# Vercel Cron bearer authentication.
CRON_SECRET=
